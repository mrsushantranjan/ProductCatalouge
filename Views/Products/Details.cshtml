@model ProductCatalogueApp.Models.Product

@{
    ViewData["Title"] = Model?.Name ?? "Product Details";
}

<div class="container mt-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Products" asp-action="Index">Products</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model?.Name</li>
        </ol>
    </nav>

    @if (Model != null)
    {
        <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
            <div class="card-header bg-primary text-white py-3 px-4 d-flex justify-content-between align-items-center">
                <h4 class="mb-0 fw-semibold">@Model.Name</h4>
                <span class="badge bg-light text-dark rounded-pill px-3 py-2">@Model.Category</span>
            </div>
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-md-8">
                        <h6 class="text-uppercase text-muted fw-bold small">Product Description</h6>
                        <p class="fs-5 mt-2">@Model.Description</p>
                    </div>
                    <div class="col-md-4">
                        <div class="p-4 bg-light rounded-3 text-center border">
                            <span class="text-muted d-block mb-1">Price</span>
                            <div class="display-6 fw-bold text-success mb-3">$@Model.Price.ToString("F2")</div>
                            <div class="d-grid gap-2">
                                <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary rounded-pill">
                                    &larr; Back to Catalogue
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning" role="alert">
            Product details not found. <a asp-controller="Products" asp-action="Index" class="alert-link">Return to Catalogue</a>.
        </div>
    }
</div>
