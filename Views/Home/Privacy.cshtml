@* Views/Home/Privacy.cshtml *@
@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-9">
            <div class="card shadow-sm p-4 p-md-5">
                <h1 class="display-6 fw-bold border-bottom pb-3 mb-4">@ViewData["Title"]</h1>
                
                <p class="text-muted mb-4"><strong>Effective Date:</strong> September 29, 2026</p>
                
                <p class="lead text-secondary mb-4">
                    This Privacy Policy describes how your information is handled when you use our <strong>Product Catalogue Web Application</strong>. 
                    Your privacy is important to us, and we are committed to being completely transparent about how this website operates.
                </p>

                <h4 class="mt-4 text-dark">1. Information We Collect</h4>
                <ul class="list-unstyled ps-3 mb-4">
                    <li class="mb-2"><strong>No Personal Data Collection:</strong> This application is a product showcase platform. We do not require you to create an account, register, or provide any personal details (such as your name, email address, or phone number) to browse our catalogue.</li>
                    <li><strong>No Cookies or Tracking:</strong> We do not use tracking cookies, analytics tools, or advertising trackers to monitor your browsing behavior.</li>
                </ul>

                <h4 class="mt-4 text-dark">2. How We Use Information</h4>
                <p class="text-secondary mb-4">
                    Because we do not collect any personal data, we do not use, process, sell, or rent any information about you to third parties.
                </p>

                <h4 class="mt-4 text-dark">3. Third-Party Links</h4>
                <p class="text-secondary mb-4">
                    Our catalogue may occasionally contain links to external websites or merchants. If you click on a third-party link, you will be directed to that site. We have no control over and assume no responsibility for the privacy practices of any third-party websites.
                </p>

                <h4 class="mt-4 text-dark">4. Changes to This Policy</h4>
                <p class="text-secondary mb-4">
                    We may update our Privacy Policy from time to time. Any changes will be posted directly on this page with an updated effective date.
                </p>

                <h4 class="mt-4 text-dark">5. Contact Us</h4>
                <p class="text-secondary mb-0">
                    If you have any questions or suggestions regarding this privacy policy, please contact us at: 
                    <a href="sushantpathak2028@gmail.com" class="text-decoration-none fw-semibold">sushantpathak2028@gmail.com</a>.
                </p>
            </div>
        </div>
    </div>
</div>
