@model IEnumerable<ProductCatalogueApp.Models.Product>

@{
    ViewData["Title"] = "Product Catalogue";
}

<div class="container mt-4">
    <h1 class="mb-4">Product Catalogue</h1>
    
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <span class="badge bg-secondary mb-2">@item.Category</span>
                        <h5 class="card-title">@item.Name</h5>
                        <p class="card-text text-truncate">@item.Description</p>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span class="h5 mb-0 text-primary">$@item.Price</span>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark">View Details</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
